# Nigel — modelo de configuração. Copie para `.env` e preencha suas chaves.
# `.env` fica de fora do Git (ver .gitignore) — este arquivo é o único que
# vai pro repositório, sem nenhuma chave real.

COMPOSIO_API_KEY=

# Qual provider de LLM usar por padrão. Um dos: groq, openai, gemini,
# openrouter, ollama, ollama_cloud.
NIGEL_ACTIVE_PROVIDER=

NIGEL_OLLAMA_CLOUD_API_KEY=
NIGEL_OLLAMA_CLOUD_MODEL=minimax-m3

NIGEL_GROQ_API_KEY=
NIGEL_GROQ_MODEL=openai/gpt-oss-120b

NIGEL_OPENAI_API_KEY=
NIGEL_OPENAI_MODEL=gpt-5.6-luna

NIGEL_GEMINI_API_KEY=
NIGEL_GEMINI_MODEL=gemini-2.5-flash-lite

NIGEL_OPENROUTER_API_KEY=
NIGEL_OPENROUTER_MODEL=openai/gpt-oss-120b

# Deixe em branco para usar o padrão (http://localhost:11434).
NIGEL_OLLAMA_URL=
NIGEL_OLLAMA_MODEL=llama3.1:8b

NIGEL_BAR_WIDTH=380
NIGEL_BAR_HEIGHT=44
